DATABASE_URL=postgresql+asyncpg://mzaiko:mzaiko_pass@db:5432/mzaiko_db
REDIS_URL=redis://redis:6379/0
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
REQUEST_TIMEOUT=30000
MAX_RETRIES=3

# eBay 共通（OAuth）
EBAY_CLIENT_ID=your_ebay_client_id
EBAY_CLIENT_SECRET=your_ebay_client_secret
EBAY_REFRESH_TOKEN=your_user_refresh_token
EBAY_ENVIRONMENT=production

# Browse API
EBAY_OAUTH_SCOPE=https://api.ebay.com/oauth/api_scope
EBAY_MARKETPLACE=EBAY_US
EBAY_SEARCH_LIMIT=50

# User OAuth
EBAY_OAUTH_USER_SCOPE=https://api.ebay.com/oauth/api_scope/sell.inventory https://api.ebay.com/oauth/api_scope/sell.fulfillment.readonly
EBAY_INVENTORY_API_TIMEOUT=15.0
EBAY_TOKEN_REQUEST_TIMEOUT=15.0

# eBay Listing
EBAY_LISTING_REQUEST_TIMEOUT=30.0
EBAY_LISTING_MARKETPLACE_ID=EBAY_US
EBAY_LISTING_CURRENCY=USD
EBAY_LISTING_CATEGORY_ID=
EBAY_LISTING_MARKUP_PERCENT=5.0
EBAY_SKU_PREFIX=mzaiko-
EBAY_MERCHANT_LOCATION_KEY=
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_LISTING_MAX_RETRIES=2
EBAY_MAX_IMAGE_COUNT=12

# eBay販売文章 AI Provider（template / openai / claude）
LISTING_COPY_PROVIDER=template

# Auto stop / auto revise
AUTO_STOP_ENABLED=true
AUTO_REVISE_PRICE=true
MIN_PROFIT_RATE=10.0

# eBay Order Sync
EBAY_ORDER_SYNC_ENABLED=true
EBAY_ORDER_SYNC_INTERVAL_MINUTES=15

# eBay Buyer Message AI auto-reply
EBAY_MESSAGE_SYNC_ENABLED=true
EBAY_MESSAGE_SYNC_INTERVAL_MINUTES=10
AUTO_REPLY_SEND_ENABLED=false

# Revise Worker
REVISE_WORKER_ENABLED=true
REVISE_WORKER_INTERVAL_MINUTES=10
REVISE_WORKER_BATCH_LIMIT=50
REVISE_WORKER_CONCURRENCY=3
REVISE_WORKER_DRY_RUN=false
OUT_OF_STOCK_ACTION=set_zero
MIN_PROFIT_YEN=500
MIN_PROFIT_MARGIN_PERCENT=10.0

# Sold Sync Worker
SOLD_SYNC_ENABLED=true
SOLD_SYNC_INTERVAL_MINUTES=5
SOLD_SYNC_CONCURRENCY=3
SOLD_SYNC_LOOKBACK_HOURS=24
SOLD_SYNC_PAGE_LIMIT=200
SOLD_SYNC_REQUEST_TIMEOUT=30.0
SOLD_SYNC_MAX_RETRIES=2
SOLD_SYNC_DRY_RUN=false

# 配送見積
SHIPPING_VOLUMETRIC_DIVISOR=5000
SHIPPING_DEFAULT_WEIGHT_GRAM=500
SHIPPING_DEFAULT_LENGTH_CM=25
SHIPPING_DEFAULT_WIDTH_CM=18
SHIPPING_DEFAULT_HEIGHT_CM=5

# 利益バッファ
FX_BUFFER_PERCENT=2.0
REFUND_BUFFER_PERCENT=3.0

# Country Risk（CSV 空ならコード内デフォルトを使用）
RISK_BLOCKED_COUNTRIES=
RISK_HIGH_COUNTRIES=
RISK_MEDIUM_COUNTRIES=
RISK_BUFFER_LOW_PERCENT=3.0
RISK_BUFFER_MEDIUM_PERCENT=7.0
RISK_BUFFER_HIGH_PERCENT=15.0

FX_RATE_USD_JPY=150.0

# 利益判定
PROFIT_THRESHOLD=15
DEFAULT_SHIPPING_COST=2000
EBAY_FEE_PERCENT=0.13

# 一括解析
MAX_CONCURRENT_ANALYSIS=3
BULK_ANALYZE_TIMEOUT_SECONDS=120
BULK_ANALYZE_MAX_RETRIES=2
BULK_ANALYZE_MAX_URLS=500

# キャッシュ
AMAZON_CACHE_TTL=3600
EBAY_CACHE_TTL=1800

# 定期監視
MONITOR_INTERVAL_MINUTES=10
MONITOR_BATCH_SIZE=50
MONITOR_ENABLED=true

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXX/YYYY/ZZZZ
SLACK_NOTIFICATIONS_ENABLED=true
SLACK_REQUEST_TIMEOUT_SECONDS=10
SLACK_MAX_RETRIES=2

# 需要スコアリング
SCORE_PROFIT_WEIGHT=0.5
SCORE_DEMAND_WEIGHT=0.3
SCORE_COMPETITION_WEIGHT=0.2
SCORE_THRESHOLD=70

# リスクフィルタ（VeRO / Hazmat）
RISK_FILTER_ENABLED=true
RISK_VERO_BRANDS=
RISK_HAZMAT_KEYWORDS=

# Amazonランキング
RANKING_CACHE_TTL=3600
RANKING_PAGE_DELAY_SECONDS=2.0
RANKING_MAX_PAGES=2
RANKING_DEFAULT_LIMIT=50

# API Key 認証
API_KEY=your-secret-key
API_AUTH_ENABLED=true

# CJ Dropshipping API（developers.cjdropshipping.com で発行）
CJ_API_KEY=CJUserNum@api@xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CJ_API_BASE=https://developers.cjdropshipping.com/api2.0/v1
CJ_TOKEN_CACHE_TTL=1036800
CJ_REQUEST_TIMEOUT=30.0
CJ_DEFAULT_PAGE_SIZE=20

# CJ 自動発注（eBayで売れた → CJに反映）
CJ_ORDER_ENABLED=true
CJ_ORDER_DRY_RUN=true             # true = payload生成のみ（CJ APIを呼ばない）
CJ_AUTO_ORDER_ON_SOLD=false       # true = 売れた瞬間に発注（reviewをスキップ）
CJ_ORDER_ON_APPROVE=true          # fulfillment task の approve 時に発注
CJ_ORDER_FROM_COUNTRY_CODE=CN
CJ_ORDER_LOGISTIC_NAME=           # 空ならCJ既定の配送方法
CJ_ORDER_PAY_TYPE=2
CJ_ORDER_REMARK=
CJ_ORDER_MAX_ATTEMPTS=3
CJ_ORDER_BACKFILL_DAYS=30         # CJ発注レコードが無い既存注文を拾う範囲（0で無効）

# CJ 注文ステータス同期（CJ出荷 → eBayへtracking反映）
CJ_ORDER_SYNC_ENABLED=true
CJ_ORDER_SYNC_INTERVAL_MINUTES=30
CJ_ORDER_SYNC_BATCH_LIMIT=50
CJ_ORDER_PUSH_TRACKING_TO_EBAY=true
CJ_DEFAULT_CARRIER_CODE=Other

# 通関リスク対策（まとめ発送で商用輸入とみなされ返送されるのを防ぐ）
CUSTOMS_SPLIT_ENABLED=true
CUSTOMS_DEFAULT_MAX_UNITS_PER_PARCEL=5   # 通常商材の1小包あたり上限
CUSTOMS_MEDIUM_MAX_UNITS_PER_PARCEL=2    # 液体・粉末・電池など
CUSTOMS_HIGH_MAX_UNITS_PER_PARCEL=1      # 化粧品・日焼け止め・サプリなど
CUSTOMS_HIGH_RISK_KEYWORDS=              # 空ならデフォルト定義を使用
CUSTOMS_MEDIUM_RISK_KEYWORDS=
CUSTOMS_MAX_SPLIT_PARCELS=10             # 分割しすぎの安全弁
CUSTOMS_ALERT_ON_RETURNED=true           # 返送検知時にSlack通知

# Rate Limit
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ANALYZE_PER_MINUTE=20
RATE_LIMIT_BULK_PER_HOUR=10
RATE_LIMIT_RANKING_PER_10MIN=20

# ログ
LOG_LEVEL=INFO
