# =============================================================================
#  本番環境 (.env.production) テンプレート
# -----------------------------------------------------------------------------
#  使い方:
#    1. このファイルを `.env.production` という名前でコピー
#         cp .env.production.example .env.production
#    2. 各項目の値を実値に書き換える（CHANGE_ME と書かれている箇所）
#    3. .env.production は .gitignore に含まれているので絶対に commit しない
#
#  運用コマンド（VPS上）:
#    docker compose -f docker-compose.prod.yml --env-file .env.production up -d
#
#  記号の意味:
#    [必須]   未設定だと起動 or 機能停止
#    [任意]   未設定でも動く（機能だけ無効化される）
#    [既定]   未設定なら下記のデフォルト値で動作
# =============================================================================


# -----------------------------------------------------------------------------
# 1. 公開設定（VPS の運用情報）
# -----------------------------------------------------------------------------
# [必須] サイトを公開するドメイン名（VPSのIPに A レコード設定済みのもの）
DOMAIN=example.com

# [必須] Let's Encrypt の通知先メール（証明書失効間近にここへ通知が来る）
LETSENCRYPT_EMAIL=admin@example.com


# -----------------------------------------------------------------------------
# 2. PostgreSQL（DB本体・永続化）
# -----------------------------------------------------------------------------
# [必須] DB 接続情報。最低 16 文字のランダム文字列を推奨。
#        生成例: PowerShell  → -join ((33..126) | Get-Random -Count 24 | %{[char]$_})
#                Linux/Mac    → openssl rand -base64 24
POSTGRES_USER=mzaiko
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=mzaiko_db

# [必須] アプリ→DB の接続URL。POSTGRES_USER / POSTGRES_PASSWORD と一致させる
DATABASE_URL=postgresql+asyncpg://mzaiko:CHANGE_ME_STRONG_PASSWORD@db:5432/mzaiko_db


# -----------------------------------------------------------------------------
# 3. Redis（キャッシュ・トークン・rate limit）
# -----------------------------------------------------------------------------
# [既定] docker-compose 内の redis サービスを使う場合は変更不要
REDIS_URL=redis://redis:6379/0


# -----------------------------------------------------------------------------
# 4. 内部 API 認証（X-API-Key ヘッダの値）
# -----------------------------------------------------------------------------
# [必須] 32 文字以上のランダムを推奨。漏れると外部から API 全コール可能になる。
API_KEY=CHANGE_ME_RANDOM_32_OR_MORE_CHARS

# [既定] true。false にすると認証なしで誰でも叩けるので本番では必ず true
API_AUTH_ENABLED=true


# -----------------------------------------------------------------------------
# 5. eBay API（OAuth + listing/order/messaging）
# -----------------------------------------------------------------------------
# [必須] dev.ebay.com の Application Keys から取得
#        Production Keyset の App ID / Cert ID
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# [必須] User OAuth フロー完了後に発行される Refresh Token（180日有効）
EBAY_REFRESH_TOKEN=

# [既定] production / sandbox の切替
EBAY_ENVIRONMENT=production

# [必須] 出品時の eBay カテゴリ ID（leaf=末端カテゴリ）
#        例: 9355=Cell Phones & Smartphones、11700=Home & Garden 等
EBAY_LISTING_CATEGORY_ID=

# [必須] eBay Seller の merchant location key、business policy ID
#        sell.account API or seller hub から取得
EBAY_MERCHANT_LOCATION_KEY=
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=

# [既定] 1 商品あたりの画像最大枚数（eBay 上限 12）
EBAY_MAX_IMAGE_COUNT=12

# [既定] EBAY_US / EBAY_GB / EBAY_DE / EBAY_AU 等
EBAY_LISTING_MARKETPLACE_ID=EBAY_US
EBAY_LISTING_CURRENCY=USD


# -----------------------------------------------------------------------------
# 6. CJ Dropshipping API（仕入れ・画像・在庫）
# -----------------------------------------------------------------------------
# [必須] developers.cjdropshipping.com で発行
#        形式: CJUserNum@api@xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CJ_API_KEY=

# [既定] CJ API base URL とタイムアウト
CJ_API_BASE=https://developers.cjdropshipping.com/api2.0/v1
CJ_TOKEN_CACHE_TTL=1036800
CJ_REQUEST_TIMEOUT=30.0
CJ_DEFAULT_PAGE_SIZE=20


# -----------------------------------------------------------------------------
# 7. 自動運営（auto-stop / auto-repricing）
# -----------------------------------------------------------------------------
# [既定] 利益率/在庫/リスクで自動 withdraw・revise する
AUTO_STOP_ENABLED=true
AUTO_REVISE_PRICE=true

# [既定] 利益率（%）これ未満で自動価格改定 or 取下げ
MIN_PROFIT_RATE=10.0

# [既定] auto repricing の scheduler ジョブ
AUTO_REPRICING_ENABLED=true
AUTO_REPRICING_INTERVAL_MINUTES=60
AUTO_REPRICING_DRY_RUN=false
AUTO_REPRICING_BATCH_LIMIT=200


# -----------------------------------------------------------------------------
# 8. Order Sync（eBay Fulfillment API → DB）
# -----------------------------------------------------------------------------
# [既定] 注文の取得頻度
EBAY_ORDER_SYNC_ENABLED=true
EBAY_ORDER_SYNC_INTERVAL_MINUTES=15


# -----------------------------------------------------------------------------
# 9. Buyer Message（AI 下書き、人間レビュー前提）
# -----------------------------------------------------------------------------
# [既定] メッセージ取得・分類の頻度
EBAY_MESSAGE_SYNC_ENABLED=true
EBAY_MESSAGE_SYNC_INTERVAL_MINUTES=10

# [既定] false。true にすると AI 下書きを人間承認なしで送信する。本番は false 推奨。
AUTO_REPLY_SEND_ENABLED=false

# [既定] template / openai / claude（後者2つは将来差し替え）
LISTING_COPY_PROVIDER=template


# -----------------------------------------------------------------------------
# 10. Monitoring / Alert（任意）
# -----------------------------------------------------------------------------
# [任意] 失敗・異常通知を送る webhook。未設定なら通知だけスキップ（運用は継続）
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=


# -----------------------------------------------------------------------------
# 11. 監視・スコアリング・rate limit（既定値で動く）
# -----------------------------------------------------------------------------
# [既定] monitoring scheduler
MONITOR_INTERVAL_MINUTES=10
MONITOR_BATCH_SIZE=50
MONITOR_ENABLED=true

# [既定] revise / sold sync ワーカー
REVISE_WORKER_ENABLED=true
REVISE_WORKER_INTERVAL_MINUTES=10
REVISE_WORKER_BATCH_LIMIT=50
SOLD_SYNC_ENABLED=true
SOLD_SYNC_INTERVAL_MINUTES=5

# [既定] FX レート（USD 換算用）。実際の為替に合わせて適宜変更
FX_RATE_USD_JPY=150.0

# [既定] rate limit（IP/キー単位ではなくグローバル）
RATE_LIMIT_ENABLED=true


# -----------------------------------------------------------------------------
# 12. ログ
# -----------------------------------------------------------------------------
# [既定] DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
